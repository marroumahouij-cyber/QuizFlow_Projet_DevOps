
pipeline {
    agent any

    environment {
        PATH+DOCKER = 'C:\\Users\\ASUS\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'node --version'
                    bat 'npm.cmd --version'
                    bat 'docker --version'
                    bat 'docker compose version'
                    bat 'if not exist artifacts mkdir artifacts'
                }
            }
        }

        stage('Build') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'npm.cmd test > artifacts/tests.log 2>&1'
                    bat 'type artifacts\\tests.log'

                    bat 'npm.cmd run build > artifacts/build.log 2>&1'
                    bat 'type artifacts\\build.log'
                }
            }
        }

        stage('Run (Docker)') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'docker compose down --remove-orphans'
                    bat 'docker compose up -d --build'
                    bat 'docker compose ps > artifacts/docker-status.txt'
                }
            }
        }

        stage('Smoke Test') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'npm.cmd run smoke > artifacts/smoke-build.log 2>&1'

                    bat 'docker compose exec -T web wget -q -O - http://127.0.0.1/health > artifacts/smoke-http.txt'

                    bat 'findstr /C:"ok" artifacts\\smoke-http.txt'

                    bat 'docker compose exec -T web wget -q -O - http://127.0.0.1/ > artifacts/smoke-page.html'

                    bat 'findstr /C:"QuizFlow" artifacts\\smoke-page.html'
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'node scripts/prepare-artifacts.js'

                    bat 'docker image ls quizflow > artifacts/docker-images.txt'

                    archiveArtifacts(
                        artifacts: 'artifacts/**/*,dist/**/*',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    post {
        always {
            dir('QuizFlow_Projet_DevOps') {
                bat(
                    returnStatus: true,
                    script: 'if not exist artifacts mkdir artifacts'
                )

                bat(
                    returnStatus: true,
                    script: 'docker compose logs --no-color > artifacts/container.log 2>&1'
                )

                archiveArtifacts(
                    artifacts: 'artifacts/**/*,dist/**/*',
                    allowEmptyArchive: true
                )

                bat(
                    returnStatus: true,
                    script: 'docker compose down --remove-orphans'
                )
            }
        }

        success {
            echo 'PASSED - Pull Request QuizFlow'
        }

        failure {
            echo 'FAILED - Consulter les logs Jenkins et les artefacts'
        }
    }
}
