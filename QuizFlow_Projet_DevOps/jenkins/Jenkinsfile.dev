// QuizFlow DEV - Windows Jenkins (LocalSystem) + Docker Desktop
// Script Path: QuizFlow_Projet_DevOps/jenkins/Jenkinsfile.dev
// Pipeline push dev: d'abord tester manuellement, puis activer Poll SCM pour dev.
pipeline {
    agent any

    environment {
        // Your Docker Desktop installation under Windows account ASUS.
        PATH = "C:\\Users\\ASUS\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        COMPOSE_EXE = 'C:\\Users\\ASUS\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins\\docker-compose.exe'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'if not exist artifacts mkdir artifacts'
                    bat 'node --version'
                    bat 'npm.cmd --version'
                    bat 'docker --version'

                    // Do not search for Compose dynamically: use the confirmed full path.
                    bat 'if not exist "%COMPOSE_EXE%" (echo ERROR: docker-compose.exe introuvable & exit /b 1)'
                    bat '"%COMPOSE_EXE%" version'

                    // Test Docker Engine access from the actual Jenkins service account.
                    script {
                        int result = bat(returnStatus: true,
                            script: 'docker info --format "{{.ServerVersion}}"')
                        if (result != 0) {
                            echo 'Docker Engine: trying the Docker Desktop Linux named pipe.'
                            env.DOCKER_HOST = 'npipe:////./pipe/dockerDesktopLinuxEngine'
                            bat 'docker info --format "{{.ServerVersion}}"'
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'npm.cmd test > artifacts/tests.log 2>&1'
                    bat 'type artifacts\\tests.log'
                    bat 'npm.cmd run build > artifacts/build.log 2>&1'
                    bat 'type artifacts\\build.log'
                }
            }
        }

        stage('Builds paralleles Node 20 et Node 22') {
            parallel {
                stage('Node 20') {
                    steps {
                        dir('QuizFlow_Projet_DevOps') {
                            bat 'docker run --rm -v "%CD%:/src:ro" node:20-alpine sh -c "mkdir -p /app && cp -R /src/. /app && cd /app && npm test && npm run build" > artifacts/node20.log 2>&1'
                            bat 'type artifacts\\node20.log'
                        }
                    }
                }
                stage('Node 22') {
                    steps {
                        dir('QuizFlow_Projet_DevOps') {
                            bat 'docker run --rm -v "%CD%:/src:ro" node:22-alpine sh -c "mkdir -p /app && cp -R /src/. /app && cd /app && npm test && npm run build" > artifacts/node22.log 2>&1'
                            bat 'type artifacts\\node22.log'
                        }
                    }
                }
            }
        }

        stage('Run (Docker)') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    // Dedicated Compose project; do not touch other user containers.
                    bat '"%COMPOSE_EXE%" -p quizflow-dev-ci up -d --build'
                    bat '"%COMPOSE_EXE%" -p quizflow-dev-ci ps > artifacts/docker-status.txt'
                    bat 'type artifacts\\docker-status.txt'
                }
            }
        }

        stage('Smoke Test') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'npm.cmd run smoke > artifacts/smoke-build.log 2>&1'
                    bat 'type artifacts\\smoke-build.log'
                    bat '"%COMPOSE_EXE%" -p quizflow-dev-ci exec -T web wget -q -O - http://127.0.0.1/health > artifacts/smoke-http.txt'
                    bat 'findstr /C:"ok" artifacts\\smoke-http.txt'
                    bat '"%COMPOSE_EXE%" -p quizflow-dev-ci exec -T web wget -q -O - http://127.0.0.1/ > artifacts/smoke-page.html'
                    bat 'findstr /C:"QuizFlow" artifacts\\smoke-page.html'
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'node scripts/prepare-artifacts.js'
                    bat 'docker image ls quizflow > artifacts/docker-images.txt'
                    archiveArtifacts artifacts: 'artifacts/**/*,dist/**/*', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            dir('QuizFlow_Projet_DevOps') {
                bat(returnStatus: true, script: 'if not exist artifacts mkdir artifacts')
                bat(returnStatus: true,
                    script: 'if exist "%COMPOSE_EXE%" "%COMPOSE_EXE%" -p quizflow-dev-ci logs --no-color > artifacts/container.log 2>&1')
                archiveArtifacts artifacts: 'artifacts/**/*,dist/**/*', allowEmptyArchive: true
                bat(returnStatus: true,
                    script: 'if exist "%COMPOSE_EXE%" "%COMPOSE_EXE%" -p quizflow-dev-ci down --remove-orphans')
            }
        }
        success {
            echo 'PASSED - QuizFlow push dev (test manuel; declencheur a activer)'
        }
        failure {
            echo 'FAILED - See Setup / Docker Engine / archived logs for details.'
        }
    }
}
