// QuizFlow - Versioning pipeline (Windows Jenkins / LocalSystem / Docker Desktop)
// Jenkins job: QuizFlow-Versioning
// Pipeline script from SCM -> Branch Specifier: refs/tags/v1.0.0
// Script Path: QuizFlow_Projet_DevOps/jenkins/Jenkinsfile.release
pipeline {
    agent any

    environment {
        PATH = "C:\\Users\\ASUS\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        COMPOSE_EXE = 'C:\\Users\\ASUS\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins\\docker-compose.exe'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'if not exist artifacts mkdir artifacts'
                    bat 'node --version'
                    bat 'npm.cmd --version'
                    bat 'docker --version'
                    bat 'if not exist "%COMPOSE_EXE%" (echo ERROR: docker-compose.exe introuvable & exit /b 1)'
                    bat '"%COMPOSE_EXE%" version'

                    // A classic Pipeline job does not set TAG_NAME automatically.
                    // Read the tag that points exactly to the checked-out commit.
                    script {
                        String detected = bat(
                            returnStdout: true,
                            script: '@git describe --tags --exact-match'
                        ).trim()
                        if (!(detected ==~ /^v\d+\.\d+\.\d+$/)) {
                            error("Invalid release tag: ${detected}. Expected vX.Y.Z")
                        }
                        env.TAG_NAME = detected
                        echo "Release tag verified: ${env.TAG_NAME}"
                    }
                    bat 'node scripts/validate-tag.js'
                    bat 'echo %TAG_NAME% > artifacts/release-version.txt'

                    // Check Docker Desktop Engine using the current LocalSystem identity.
                    script {
                        int engine = bat(
                            returnStatus: true,
                            script: 'docker info --format "{{.ServerVersion}}"'
                        )
                        if (engine != 0) {
                            echo 'Trying Docker Desktop Linux Engine named pipe.'
                            env.DOCKER_HOST = 'npipe:////./pipe/dockerDesktopLinuxEngine'
                            bat 'docker info --format "{{.ServerVersion}}"'
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'npm.cmd test > artifacts/tests.log 2>&1'
                    bat 'type artifacts\\tests.log'
                    bat 'npm.cmd run build > artifacts/build.log 2>&1'
                    bat 'type artifacts\\build.log'
                }
            }
        }

        stage('Run (Docker)') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    // Dedicated project: does not shut down n8n or EduGestion.
                    bat '"%COMPOSE_EXE%" -p quizflow-release-ci up -d --build'
                    bat '"%COMPOSE_EXE%" -p quizflow-release-ci ps > artifacts/docker-status.txt'
                    bat 'type artifacts\\docker-status.txt'
                }
            }
        }

        stage('Smoke Test') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'npm.cmd run smoke > artifacts/smoke-build.log 2>&1'
                    bat 'type artifacts\\smoke-build.log'
                    bat '"%COMPOSE_EXE%" -p quizflow-release-ci exec -T web wget -q -O - http://127.0.0.1/health > artifacts/smoke-http.txt'
                    bat 'findstr /C:"ok" artifacts\\smoke-http.txt'
                    bat '"%COMPOSE_EXE%" -p quizflow-release-ci exec -T web wget -q -O - http://127.0.0.1/ > artifacts/smoke-page.html'
                    bat 'findstr /C:"QuizFlow" artifacts\\smoke-page.html'
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                dir('QuizFlow_Projet_DevOps') {
                    bat 'node scripts/prepare-artifacts.js'
                    bat 'docker image tag quizflow:local quizflow:%TAG_NAME%'
                    bat 'docker image inspect quizflow:%TAG_NAME% --format "{{.Id}}" > artifacts/release-image-id.txt'
                    bat 'docker image ls quizflow > artifacts/docker-images.txt'
                    bat 'type artifacts\\release-version.txt'
                    archiveArtifacts artifacts: 'artifacts/**/*,dist/**/*', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            dir('QuizFlow_Projet_DevOps') {
                bat(returnStatus: true, script: 'if not exist artifacts mkdir artifacts')
                bat(returnStatus: true, script: 'if exist "%COMPOSE_EXE%" "%COMPOSE_EXE%" -p quizflow-release-ci logs --no-color > artifacts/container.log 2>&1')
                archiveArtifacts artifacts: 'artifacts/**/*,dist/**/*', allowEmptyArchive: true
                bat(returnStatus: true, script: 'if exist "%COMPOSE_EXE%" "%COMPOSE_EXE%" -p quizflow-release-ci down --remove-orphans')
            }
        }
        success {
            echo "PASSED - QuizFlow release ${env.TAG_NAME} (manual build; automatic tag trigger not yet configured)"
        }
        failure {
            echo 'FAILED - See Setup, tag validation and archived logs.'
        }
    }
}
